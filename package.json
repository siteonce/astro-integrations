{
  "name": "astro-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Snapshot monorepo for Astro content sites.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter marketing dev",
    "build": "pnpm --filter marketing build",
    "preview": "pnpm --filter marketing preview",
    "format": "biome format --write . && prettier --write \"**/*.{astro,md,mdx}\"",
    "format:check": "biome format . && prettier --check \"**/*.{astro,md,mdx}\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write . && prettier --write \"**/*.{astro,md,mdx}\"",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
