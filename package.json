{
  "name": "astro-stack",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the astro-lib integration and the starter that consumes it.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter starter dev",
    "build": "pnpm --filter starter build",
    "preview": "pnpm --filter starter preview",
    "format": "biome format --write . && prettier --write \"**/*.{astro,md}\"",
    "format:check": "biome format . && prettier --check \"**/*.{astro,md}\"",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write . && prettier --write \"**/*.{astro,md}\"",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.2.2",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "husky": "9.1.7",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
