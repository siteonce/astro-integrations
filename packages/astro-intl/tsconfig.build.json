{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Emit one JS file per source file into dist/. Extends the root baseline
  // directly so the dev-only `source` condition is not part of the build.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
