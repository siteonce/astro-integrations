---
// Prints the rel="alternate" links it is given, including x-default when that
// link is in the list. Sit in slot="head" next to Seo. Does not import Seo
// and does not inject tags itself.
interface Props {
  links: { hreflang: string; href: string }[];
}

const { links } = Astro.props;
---

{links.map((link) => (
  <link rel="alternate" hreflang={link.hreflang} href={link.href} />
))}
