{
  "plugins": ["prettier-plugin-astro"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": "*.md",
      "options": { "parser": "markdown", "proseWrap": "never" }
    },
    {
      "files": "*.mdx",
      "options": { "parser": "mdx" }
    }
  ]
}
