---
// 404 fallback. Not a view. Catalog copy via t(), and noindex so error pages
// stay out of search.
import { getRelativeLocaleUrl } from 'astro:i18n';
import SiteLayout from '../layouts/site-layout.astro';
import { defaultLocale, locales } from '../utils/intl.ts';
import { useTranslations } from '../utils/t.ts';

const locale = locales.find((code) => code === Astro.currentLocale) ?? defaultLocale;
const t = useTranslations(locale);
const homeHref = getRelativeLocaleUrl(locale);
---

<SiteLayout locale={locale} title={t('notFound.title')} description={t('notFound.body')} noindex>
  <main>
    <h1>{t('notFound.title')}</h1>
    <p>{t('notFound.body')}</p>
    <p>
      <a href={homeHref}>{t('notFound.backHome')}</a>
    </p>
  </main>
</SiteLayout>
