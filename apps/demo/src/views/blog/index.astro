---
// Listing. One chunk of that locale's published posts, newest first. This view
// sets that order. The HTML title comes from the catalog. `listingPaths` emits
// each page and its path.
import type { GetStaticPathsOptions, InferGetStaticPropsType } from 'astro';
import PostList from '../../components/post-list.svelte';
import SiteLayout from '../../layouts/site-layout.astro';
import { listingPaths, viewProps } from '../../utils/intl.ts';
import { createPosts } from '../../utils/posts.ts';
import { postsNewestFirst } from '../../utils/sorting.ts';
import { useTranslations } from '../../utils/t.ts';

export async function getStaticPaths({ paginate, routePattern }: GetStaticPathsOptions) {
  return listingPaths(routePattern, 'posts', paginate, {
    sort: () => postsNewestFirst,
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const props = await viewProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { locale, path, page } = props;
const t = useTranslations(locale);
const posts = createPosts(locale);

const title = t('blog.title');
const description = t('blog.description');

const items = await posts.items(page.data);
---

<SiteLayout locale={locale} path={path} title={title} description={description}>
  <main>
    <h1>{title}</h1>
    <p>{description}</p>
    <PostList items={items} />
    {(page.url.prev !== undefined || page.url.next !== undefined) && (
      <nav>
        {page.url.prev !== undefined && <a href={page.url.prev}>{t('blog.previous')}</a>}
        {page.url.next !== undefined && <a href={page.url.next}>{t('blog.next')}</a>}
      </nav>
    )}
  </main>
</SiteLayout>
