{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Astro idioms (jsx: preserve, .astro/types.d.ts include) first, then the
  // monorepo strict baseline on top. `source` resolves @siteonce/astro-intl
  // to its TypeScript during `astro check`, so the demo type-checks without
  // a package build. No `paths` alias.
  "extends": ["astro/tsconfigs/strict", "../../tsconfig.json"],
  "compilerOptions": {
    "customConditions": ["source"]
  }
}
