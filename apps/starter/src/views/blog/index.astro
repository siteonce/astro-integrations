---
// Listing. One chunk of that locale's published posts. The HTML title comes
// from the catalog. `listingPaths` emits each page and its path.
import type { CollectionEntry } from 'astro:content';
import { getAlternatePathsForPath, listingPaths, setIntlConfig, viewProps } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Hero, PostList, Schema, Seo } from '@repo/astro-site/components';
import type { GetStaticPathsOptions, InferGetStaticPropsType } from 'astro';
import intlConfig from '../../intl.config.ts';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import { siteConfig } from '../../site.config.ts';
import { createPageKit } from '../../utils/page-kit.ts';

// Page bundles do not share the integration's in-memory runtime.
setIntlConfig(intlConfig);

export async function getStaticPaths({ paginate, routePattern }: GetStaticPathsOptions) {
  setIntlConfig(intlConfig);
  return listingPaths<CollectionEntry<'posts'>>(routePattern, paginate);
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const props = await viewProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { locale, path, page } = props;
const kit = createPageKit(locale);
const switcher = kit.switcher(await getAlternatePathsForPath(locale, path));
const t = kit.t;

const title = t('blog.title');
const description = t('blog.description');
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const items = await Promise.all(page.data.map((post) => kit.postItem(post)));
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      {...ogImage}
      imageAlt={title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema siteConfig={siteConfig} lang={locale} description={description} />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <Hero title={title}>
      <p>{description}</p>
    </Hero>
    <PostList items={items} />
    {(page.url.prev !== undefined || page.url.next !== undefined) && (
      <nav>
        {page.url.prev !== undefined && <a href={page.url.prev}>{t('blog.previous')}</a>}
        {page.url.next !== undefined && <a href={page.url.next}>{t('blog.next')}</a>}
      </nav>
    )}
  </main>
</SiteLayout>
