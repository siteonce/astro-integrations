---
// Post. One entry in the posts collection: the article, its byline, and related posts.
// `entryPaths` emits one path per translated entry.
import { type CollectionEntry, render } from 'astro:content';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Article, RelatedPosts, Schema, Seo } from '@repo/astro-site/components';
import { getRelatedContent } from '@repo/astro-site/utils/related-content';
import type { GetStaticPathsOptions, InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import { siteConfig } from '../../site.config.ts';
import { entryPaths, getRelated, type Relation, viewProps } from '../../utils/intl.ts';
import { createPosts } from '../../utils/posts.ts';
import { postsNewestFirst } from '../../utils/sorting.ts';
import { useTranslations } from '../../utils/t.ts';

export async function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  return entryPaths<CollectionEntry<'posts'>>(routePattern);
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const props = await viewProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { locale, path, entry } = props;
const t = useTranslations(locale);
const posts = createPosts(locale);

const title = entry.data.seoTitle;
const description = entry.data.seoDesc;
const publishedTime = entry.data.pubDate.toISOString();
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry)).Content : undefined;

// getRelatedContent keeps input order on ties, so give it a fixed order.
const ordered = (await posts.list()).toSorted(postsNewestFirst);
const terms = await posts.terms(entry.data.tags);
// getRelatedContent compares tags as strings, so give it the tag ids.
const withTagIds = <T extends { data: { tags: Relation[] } }>(post: T) => ({
  ...post,
  data: { ...post.data, tags: post.data.tags.map((tag) => tag.id) },
});
const related = await posts.related(getRelatedContent(withTagIds(entry), ordered.map(withTagIds)));
const image = posts.image(entry);

const authorEntry = entry.data.author ? await getRelated(locale, entry.data.author) : undefined;
const sourceEntry = entry.data.source ? await getRelated(locale, entry.data.source) : undefined;
const roleEntry = entry.data.role ? await getRelated(locale, entry.data.role) : undefined;
const authorName = authorEntry?.data.name as string | undefined;
const sourceName = sourceEntry?.data.name as string | undefined;
const sourceUrl = sourceEntry?.data.url as string | undefined;
const roleName = roleEntry?.data.name as string | undefined;
const byline = [authorName, roleName].filter(Boolean).join(' · ');
const source =
  sourceName && sourceUrl
    ? {
        href: sourceUrl,
        label: sourceName,
        external:
          new URL(sourceUrl, siteConfig.siteUrl).origin !== new URL(siteConfig.siteUrl).origin,
      }
    : undefined;
---

<SiteLayout locale={locale} path={path}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      type="article"
      publishedTime={publishedTime}
      {...ogImage}
      imageAlt={entry.data.og?.alt ?? title}
    />
    <Schema
      siteConfig={siteConfig}
      lang={locale}
      type="article"
      title={title}
      description={description}
      datePublished={publishedTime}
      author={authorName}
    />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    {byline ? <p>{byline}</p> : null}
    <Article
      title={title}
      datetime={publishedTime}
      dateLabel={posts.dateLabel(entry)}
      image={image}
      terms={terms}
      source={source}
    >
      {Content ? <Content /> : null}
    </Article>
    <RelatedPosts heading={t('blog.related')} items={related} />
  </main>
</SiteLayout>
