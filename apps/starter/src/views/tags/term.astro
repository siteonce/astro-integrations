---
// Term. One tags entry and the posts tagged with it.
// `entryPaths` emits one path per translated term.
import { type CollectionEntry, render } from 'astro:content';
import { entryPaths, setIntlConfig, viewProps } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Hero, PostList, Schema, Seo } from '@repo/astro-site/components';
import type { GetStaticPathsOptions, InferGetStaticPropsType } from 'astro';
import intlConfig from '../../intl.config.ts';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import { siteConfig } from '../../site.config.ts';
import { createPosts } from '../../utils/posts.ts';
import { postsNewestFirst } from '../../utils/sorting.ts';
import { useTranslations } from '../../utils/t.ts';

// Page bundles do not share the integration's in-memory runtime.
setIntlConfig(intlConfig);

export async function getStaticPaths({ routePattern }: GetStaticPathsOptions) {
  setIntlConfig(intlConfig);
  return entryPaths<CollectionEntry<'tags'>>(routePattern);
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const props = await viewProps(Astro, getStaticPaths);
if (!props) return new Response(null, { status: 404 });
const { locale, path, entry } = props;
const t = useTranslations(locale);
const posts = createPosts(locale);

const title = entry.data.seoTitle ?? t(`taxonomy.blogTags.${entry.data.id}`);
const description = entry.data.seoDesc ?? title;
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry)).Content : undefined;

const tagged = (await posts.list())
  .filter((post) => post.data.tags.some((tag) => tag.id === entry.data.id))
  .toSorted(postsNewestFirst);
const items = await Promise.all(tagged.map((post) => posts.item(post)));
---

<SiteLayout locale={locale} path={path}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      {...ogImage}
      imageAlt={title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema siteConfig={siteConfig} lang={locale} description={description} />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <Hero title={title}>{Content ? <Content /> : <p>{description}</p>}</Hero>
    <PostList items={items} />
  </main>
</SiteLayout>
