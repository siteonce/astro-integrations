---
// Catch-all. Params are compiled public tails (prefixDefaultLocale: true).
// The matching route row names the routed page under src/routes. A published
// tail with no entry renders that page. Any other path with no entry redirects
// to the default-locale entry at that tail, or rewrites not-found.
// Intl does not know routed-page names. The matched row, the switcher, and a
// page kit go to the routed page.

import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  getAlternatePathsForPath,
  getContentByPath,
  getPairedSlugs,
  setIntlConfig,
} from '@repo/astro-intl';
import intlConfig from '../../intl.config.ts';
import { createPageKit } from '../../utils/page-kit.ts';
import {
  assertRoutedPages,
  loadRoutedPage,
  matchRoute,
  pageName,
  publicTail,
} from '../../utils/routes.ts';

// Page bundles do not share the integration's in-memory runtime.
setIntlConfig(intlConfig);

export async function getStaticPaths() {
  setIntlConfig(intlConfig);
  assertRoutedPages();
  return (await getPairedSlugs()).map(({ locale, slug }) => ({
    params: { locale, path: slug === '/' ? undefined : slug },
  }));
}

const locale = Astro.currentLocale ?? Astro.params.locale;
if (!locale) {
  throw new Error('starter: catch-all missing locale.');
}

const pathParam = Astro.params.path;
const path = Array.isArray(pathParam)
  ? pathParam.filter(Boolean).join('/') || '/'
  : (pathParam ?? '/');

const entry = await getContentByPath(locale, path);
const alternates = await getAlternatePathsForPath(locale, path);
const published = Object.keys(alternates).length > 0;
if (!published) {
  const fallback = await getContentByPath(intlConfig.defaultLocale, path);
  // Already on the default-locale tail. Redirecting would repeat this URL.
  if (fallback && locale !== intlConfig.defaultLocale) {
    const tail = publicTail(path);
    const href =
      tail === '/'
        ? getRelativeLocaleUrl(intlConfig.defaultLocale)
        : getRelativeLocaleUrl(intlConfig.defaultLocale, tail);
    return Astro.redirect(href);
  }
  return Astro.rewrite('/404');
}

const route = matchRoute(locale, path, Boolean(entry));
if (!route) {
  throw new Error(`starter: no route row for "${path}".`);
}
const kit = createPageKit(locale);
const switcher = kit.switcher(alternates);
const { default: Page } = await loadRoutedPage(pageName(route, locale));
---

{entry ? (
  <Page
    locale={locale}
    path={path}
    route={route}
    switcher={switcher}
    kit={kit}
    entry={entry as never}
  />
) : (
  <Page locale={locale} path={path} route={route} switcher={switcher} kit={kit} />
)}
