---
// CMS catch-all. Params are compiled public tails (prefixDefaultLocale: true).
// A standalone route loads its joined entry and picks a `_pages` file from
// pageType. A collection entry uses the collection map. Otherwise the
// missing-locale chain runs. intl does not know page types.

import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  getContentByPath,
  getPairedSlugs,
  getRouteByPath,
  missingLocaleChain,
  setIntlConfig,
} from '@repo/astro-intl';
import type { AstroInstance } from 'astro';
import intlConfig from '../../intl.config.ts';

// Collection name and `_pages` file differ for these two. Pages use pageType.
const file: Record<string, string> = { blog: 'post', tags: 'term' };

const pages = import.meta.glob<AstroInstance>('../_pages/*.astro');

// Page bundles do not share the integration's in-memory runtime.
setIntlConfig(intlConfig);

export async function getStaticPaths() {
  setIntlConfig(intlConfig);
  return (await getPairedSlugs()).map(({ locale, slug }) => ({
    params: { locale, path: slug === '/' ? undefined : slug },
  }));
}

const locale = Astro.currentLocale ?? Astro.params.locale;
if (!locale) {
  throw new Error('starter: catch-all missing locale.');
}

const pathParam = Astro.params.path;
const path = Array.isArray(pathParam)
  ? pathParam.filter(Boolean).join('/') || '/'
  : (pathParam ?? '/');

const route = await getRouteByPath(locale, path);
const entry = await getContentByPath(locale, path);

if (route && !entry) {
  throw new Error(`starter: no content for route "${route.id}".`);
}

if (!entry) {
  const result = await missingLocaleChain({
    locale,
    path,
    defaultLocale: intlConfig.defaultLocale,
    getContentByPath,
    hrefFor: (code, tail) => (tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code)),
  });
  if (result.kind === 'redirect') return Astro.redirect(result.href);
  return Astro.rewrite('/404');
}

const name = route ? String(entry.data.pageType ?? '') : (file[entry.collection ?? ''] ?? '');
const load = pages[`../_pages/${name}.astro`];
if (!load) {
  throw new Error(`starter: no _pages file for "${name}".`);
}
const { default: Page } = await load();
---

<Page locale={locale} path={path} entry={entry as never} />
