---
// CMS catch-all. Params are document-owned compiled paths
// (prefixDefaultLocale: true). Looks up the entry, runs the missing-locale
// chain, and picks a `_pages` file from collection / page type. Does not
// compose blocks.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getContentByPath, getRoutedStaticPaths, setIntlConfig } from '@repo/astro-intl';
import intlConfig from '../../intl.config.ts';
import { missingLocaleChain } from '../../missing-locale.ts';
import { pageName } from '../../page-name.ts';
import Home from '../_pages/home.astro';
import Listing from '../_pages/listing.astro';
import Post from '../_pages/post.astro';
import Term from '../_pages/term.astro';

// Page bundles do not share the integration's in-memory runtime.
setIntlConfig(intlConfig);

export function getStaticPaths() {
  return getRoutedStaticPaths();
}

const locale = Astro.currentLocale ?? Astro.params.locale;
if (!locale) {
  throw new Error('starter: catch-all missing locale.');
}

const pathParam = Astro.params.path;
const path = Array.isArray(pathParam)
  ? pathParam.filter(Boolean).join('/') || '/'
  : (pathParam ?? '/');

const entry = await getContentByPath(locale, path);
if (!entry) {
  const result = await missingLocaleChain({
    locale,
    path,
    defaultLocale: intlConfig.defaultLocale,
    getContentByPath,
    hrefFor: (code, tail) => (tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code)),
  });
  if (result.kind === 'redirect') return Astro.redirect(result.href);
  return Astro.rewrite('/404');
}

const pages = { home: Home, listing: Listing, post: Post, term: Term };
const Page = pages[pageName(entry)];
---

<Page locale={locale} entry={entry as never} />
