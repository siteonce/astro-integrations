---
// 404 fallback. Not a routed page. Catalog chrome
// via t(); copied Seo; NotFound block. Document shell is SiteLayout →
// BaseLayout. noindex so error pages stay out of search.
import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeSwitcherLinks } from '@repo/astro-intl';
import { NotFound, Seo } from '@repo/astro-site/components';
import intlConfig from '../intl.config.ts';
import SiteLayout from '../layouts/site-layout.astro';
import { siteConfig } from '../site.config.ts';
import { useTranslations } from '../t.ts';

const locale = Astro.currentLocale ?? intlConfig.defaultLocale;
const t = useTranslations(locale);
const switcher = localeSwitcherLinks(intlConfig.locales, locale, {}, (code, tail) =>
  tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code),
).map((item) =>
  item.current || item.href ? item : { ...item, href: getRelativeLocaleUrl(item.locale) },
);
const homeHref = getRelativeLocaleUrl(locale);
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={t('notFound.title')}
      description={t('notFound.body')}
      noindex
    />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <NotFound
      title={t('notFound.title')}
      body={t('notFound.body')}
      homeHref={homeHref}
      homeLabel={t('notFound.backHome')}
    />
  </main>
</SiteLayout>
