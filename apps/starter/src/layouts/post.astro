---
// Post type layout. Receives locale + the blog-collection entry. Owns render(),
// related-post query, and Article + RelatedPosts composition. Wraps SiteLayout.
// No section UI beyond Measure / Flow on <main>.
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAlternatePaths } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { Article, RelatedPosts, Schema, Seo } from '@repo/astro-site/components';
import { isLocal, isPreview } from '@repo/astro-site/utils/deploy-env';
import { getRelatedContent } from '@repo/astro-site/utils/related-content';
import { ogImageFor } from '@repo/og-image/utils/og-image-for';
import { deployConfig } from '../deploy-config.ts';
import intlConfig from '../intl.config.ts';
import { localeSwitcherLinks } from '../locale-switcher.ts';
import { ogConfig } from '../og-config.ts';
import { siteConfig } from '../site-config.ts';
import { useTranslations } from '../t.ts';
import SiteLayout from './site-layout.astro';

interface Props {
  locale: string;
  entry: {
    id: string;
    body?: string;
    data: {
      id: string;
      slug?: string;
      seoTitle: string;
      seoDesc: string;
      pubDate: Date;
      tags: string[];
      featImage?: string;
      featImageAlt?: string;
      og?: { alt?: string };
    };
  };
}

const { locale, entry } = Astro.props;
const t = useTranslations(locale);
const alternates = await getAlternatePaths(entry.data.id);
const path = alternates[locale] ?? (entry.data.slug ? `blog/${entry.data.slug}` : '/');
const switcher = localeSwitcherLinks(intlConfig.locales, locale, alternates, (code, tail) =>
  tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code),
);

const title = entry.data.seoTitle;
const description = entry.data.seoDesc;
const publishedTime = entry.data.pubDate.toISOString();
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry as never)).Content : undefined;

const showDrafts = isLocal(deployConfig) || isPreview(deployConfig);
const posts = (await getCollection('blog'))
  .filter((post) => post.data.locale === locale && (post.data.status === 'published' || showDrafts))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tagSlug = new Map(
  (await getCollection('tags'))
    .filter((tag) => tag.data.locale === locale)
    .map((tag) => [tag.data.id, tag.data.slug]),
);
const dateFmt = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });
const terms = entry.data.tags.map((id) => {
  const key = `taxonomy.blogTags.${id}`;
  const value = t(key);
  return {
    href: getRelativeLocaleUrl(locale, `tags/${tagSlug.get(id) ?? id}`),
    label: value === key ? id : value,
  };
});
const related = getRelatedContent(entry, posts).map((post) => ({
  href: getRelativeLocaleUrl(locale, `blog/${post.data.slug}`),
  title: post.data.seoTitle,
}));
const image =
  entry.data.featImage && entry.data.featImageAlt && !entry.data.featImage.startsWith('.')
    ? { src: entry.data.featImage, alt: entry.data.featImageAlt }
    : undefined;
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      type="article"
      publishedTime={publishedTime}
      {...ogImage}
      imageAlt={entry.data.og?.alt ?? title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema
      siteConfig={siteConfig}
      lang={locale}
      type="article"
      title={title}
      description={description}
      datePublished={publishedTime}
    />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <Article
      title={title}
      datetime={publishedTime}
      dateLabel={dateFmt.format(entry.data.pubDate)}
      image={image}
      terms={terms}
    >
      {Content ? <Content /> : null}
    </Article>
    <RelatedPosts heading={t('blog.related')} items={related} />
  </main>
</SiteLayout>
