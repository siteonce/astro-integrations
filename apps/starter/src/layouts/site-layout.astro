---
// Site chrome around BaseLayout: styles, Favicon, Analytics, locale switcher,
// and a head pass-through. Document pages drop Seo/Hreflang/Schema into the
// head slot and own their landmarks. This file does not compose blocks.

import { getRelativeLocaleUrl } from 'astro:i18n';
import { localeSwitcherLinks } from '@repo/astro-intl';
import { BaseLayout } from '@repo/astro-site/components';
import { cn } from '@repo/astro-site/utils/cn';
import type { HTMLAttributes } from 'astro/types';
import Analytics from '../components/analytics.astro';
import Favicon from '../components/favicon.astro';
import intlConfig from '../intl.config.ts';
import { getAlternatePathsForPath } from '../utils/intl.ts';
import { useTranslations } from '../utils/t.ts';
import '../styles';

interface Props {
  /** Document language. Forwarded to BaseLayout as `<html lang>`. */
  locale: string;
  /**
   * This view's locale-relative path. Another locale links to the sibling
   * that publishes this tail. With no path, every other locale links to its
   * locale root and the current locale is not a link.
   */
  path?: string;
  /** Attrs on `<html>` except `lang`. Forwarded to BaseLayout. */
  html?: Omit<HTMLAttributes<'html'>, 'lang'>;
  /** Attrs on `<body>`. Forwarded to BaseLayout. */
  body?: HTMLAttributes<'body'>;
}

const { locale, path, html, body } = Astro.props;
const t = useTranslations(locale);
const hrefFor = (code: string, tail?: string) =>
  tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code);
// With no path, every locale's root stands in as its sibling.
const alternates =
  path === undefined
    ? Object.fromEntries(intlConfig.locales.map((code) => [code, '/']))
    : await getAlternatePathsForPath(locale, path);
const switcher = localeSwitcherLinks(intlConfig.locales, locale, alternates, hrefFor);
const { class: htmlClass, 'class:list': htmlClassList, ...htmlRest } = html ?? {};
const { class: bodyClass, 'class:list': bodyClassList, ...bodyRest } = body ?? {};
---

<BaseLayout
  lang={locale}
  html={{ ...htmlRest, class: cn('font-sans', htmlClass, htmlClassList) }}
  body={{ ...bodyRest, class: cn('bg-body text-body', bodyClass, bodyClassList) }}
>
  <Fragment slot="head">
    <Favicon />
    <Analytics />
    <slot name="head" />
  </Fragment>
  <header>
    <nav class="measure measure-size-wide mx-auto" aria-label={t('chrome.localeSwitcher')}>
      <ul>
        {switcher.map((item) => (
          <li>
            {item.locale === locale ? (
              <span aria-current="page">{t(`locale.${item.locale}`)}</span>
            ) : item.href ? (
              <a href={item.href} hreflang={item.locale} lang={item.locale}>
                {t(`locale.${item.locale}`)}
              </a>
            ) : (
              <span aria-disabled="true" lang={item.locale}>
                {t(`locale.${item.locale}`)}
              </span>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </header>
  <slot />
</BaseLayout>
