---
// Term page. Receives locale, the compiled path, and the tags-collection term
// page. Queries posts tagged with this term, maps view-models, and composes
// Hero + PostList. Wraps SiteLayout. No section UI beyond Measure / Flow on <main>.
import { render } from 'astro:content';
import type { LocaleSwitcherLink } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Hero, PostList, Schema, Seo } from '@repo/astro-site/components';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import type { StarterRoute } from '../../routes.config.ts';
import { siteConfig } from '../../site.config.ts';
import type { PageKit } from '../../utils/page-kit.ts';

interface Props {
  locale: string;
  path: string;
  route: StarterRoute;
  switcher: LocaleSwitcherLink[];
  kit: PageKit;
  entry: {
    id: string;
    filePath?: string;
    body?: string;
    data: {
      id: string;
      seoTitle?: string;
      seoDesc?: string;
    };
  };
}

const { locale, path, switcher, kit, entry } = Astro.props;
const t = kit.t;

const title = entry.data.seoTitle ?? t(`taxonomy.blogTags.${entry.data.id}`);
const description = entry.data.seoDesc ?? title;
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry as never)).Content : undefined;

const posts = (await kit.posts()).filter((post) =>
  post.data.tags.some((tag) => tag.id === entry.data.id),
);
const items = await Promise.all(posts.map((post) => kit.postItem(post)));
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      {...ogImage}
      imageAlt={title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema siteConfig={siteConfig} lang={locale} description={description} />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <Hero title={title}>
      {Content ? <Content /> : <p>{description}</p>}
    </Hero>
    <PostList items={items} />
  </main>
</SiteLayout>
