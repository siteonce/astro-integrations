---
// Listing. Locale and public tail. No collection entry. The HTML title comes
// from the catalog. Queries the blog collection, slices one chunk, and
// composes Hero + PostList. Wraps SiteLayout.
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getAlternatePaths, getAlternatePathsForPath, localeSwitcherLinks } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Hero, PostList, Schema, Seo } from '@repo/astro-site/components';
import { isLocal, isPreview } from '@repo/astro-site/utils/deploy-env';
import { deployConfig } from '../../deploy.config.ts';
import intlConfig from '../../intl.config.ts';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import { siteConfig } from '../../site.config.ts';
import { resolveFeatImage } from '../../utils/feat-image.ts';
import {
  listingEntries,
  listingPage,
  listingPageNumber,
  listingTail,
} from '../../utils/listing.ts';
import { localeFolder } from '../../utils/locale-folder.ts';
import { matchRoute } from '../../utils/routes.ts';
import { useTranslations } from '../../utils/t.ts';

interface Props {
  locale: string;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const alternates = await getAlternatePathsForPath(locale, path);
const switcher = localeSwitcherLinks(intlConfig.locales, locale, alternates, (code, tail) =>
  tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code),
);

const title = t('blog.title');
const description = t('blog.description');
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const route = matchRoute(locale, path, false);
if (!route) {
  throw new Error(`starter: no listing route for "${path}".`);
}
const written = route.slug[locale];
if (!written) {
  throw new Error(`starter: listing route has no tail for "${locale}".`);
}
const currentPage = listingPageNumber(written, path);
if (currentPage === undefined) {
  throw new Error(`starter: "${path}" is not a page of "${written}".`);
}
const showDrafts = isLocal(deployConfig) || isPreview(deployConfig);
const posts = listingEntries(await getCollection('blog'), locale, showDrafts);
const page = listingPage(posts, route.pageSize, currentPage, (pageNumber) => {
  const tail = listingTail(written, pageNumber);
  return tail === '/' ? getRelativeLocaleUrl(locale) : getRelativeLocaleUrl(locale, tail);
});

async function compiledPath(collection: string, id: string): Promise<string> {
  const compiled = (await getAlternatePaths(`${collection}/${id}`))[locale];
  if (!compiled) {
    throw new Error(`starter: no compiled path for "${collection}/${id}" in "${locale}".`);
  }
  return compiled;
}

const tagSlug = new Map<string, string>();
for (const tag of (await getCollection('tags')).filter((tag) => tag.data.locale === locale)) {
  tagSlug.set(localeFolder(tag), await compiledPath('tags', tag.data.id));
}
const postPath = new Map<string, string>();
for (const post of page.data) {
  postPath.set(post.data.id, await compiledPath('blog', post.data.id));
}

function documentHref(paths: Map<string, string>, collection: string, id: string): string {
  const compiled = paths.get(id);
  if (!compiled) {
    throw new Error(`starter: no compiled path for "${collection}/${id}" in "${locale}".`);
  }
  return getRelativeLocaleUrl(locale, compiled);
}

const dateFmt = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });
const items = page.data.map((post) => {
  const keyFor = (id: string) => `taxonomy.blogTags.${id}`;
  const src = resolveFeatImage(localeFolder(post), post.data.featImage);
  return {
    href: documentHref(postPath, 'blog', post.data.id),
    title: post.data.seoTitle,
    excerpt: post.data.excerpt,
    datetime: post.data.pubDate.toISOString(),
    dateLabel: dateFmt.format(post.data.pubDate),
    image: src ? { src, alt: post.data.featImageAlt } : undefined,
    terms: post.data.tags.map((id) => {
      const key = keyFor(id);
      const value = t(key);
      return {
        href: documentHref(tagSlug, 'tags', id),
        label: value === key ? id : value,
      };
    }),
  };
});
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      {...ogImage}
      imageAlt={title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema siteConfig={siteConfig} lang={locale} description={description} />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    <Hero title={title}>
      <p>{description}</p>
    </Hero>
    <PostList items={items} />
    {
      (page.url.prev !== undefined || page.url.next !== undefined) && (
        <nav>
          {page.url.prev !== undefined && <a href={page.url.prev}>{t('blog.previous')}</a>}
          {page.url.next !== undefined && <a href={page.url.next}>{t('blog.next')}</a>}
        </nav>
      )
    }
  </main>
</SiteLayout>
