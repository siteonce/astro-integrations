---
// Post page. Receives locale, the compiled path, and the blog-collection
// entry. Owns render(), related-post query, and Article + RelatedPosts
// composition. Wraps SiteLayout. No section UI beyond Measure / Flow on <main>.
import { render } from 'astro:content';
import { type LocaleSwitcherLink, type Relation, getRelated } from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Article, RelatedPosts, Schema, Seo } from '@repo/astro-site/components';
import { getRelatedContent } from '@repo/astro-site/utils/related-content';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import type { StarterRoute } from '../../routes.config.ts';
import { siteConfig } from '../../site.config.ts';
import { resolveFeatImage } from '../../utils/feat-image.ts';
import { localeFolder } from '../../utils/locale-folder.ts';
import type { PageKit } from '../../utils/page-kit.ts';

interface Props {
  locale: string;
  path: string;
  route: StarterRoute;
  switcher: LocaleSwitcherLink[];
  kit: PageKit;
  entry: {
    id: string;
    filePath?: string;
    body?: string;
    data: {
      id: string;
      seoTitle: string;
      seoDesc: string;
      pubDate: Date;
      tags: string[];
      author?: Relation;
      source?: Relation;
      role?: Relation;
      featImage?: string;
      featImageAlt?: string;
      og?: { alt?: string };
    };
  };
}

const { locale, path, switcher, kit, entry } = Astro.props;
const t = kit.t;

const title = entry.data.seoTitle;
const description = entry.data.seoDesc;
const publishedTime = entry.data.pubDate.toISOString();
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry as never)).Content : undefined;

const posts = await kit.posts();
const dateFmt = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });
const terms = await kit.terms(entry.data.tags);
const related = await Promise.all(
  getRelatedContent(entry, posts).map(async (post) => ({
    href: await kit.href('blog', post.data.id),
    title: post.data.seoTitle,
  })),
);
const featSrc = entry.data.featImage
  ? resolveFeatImage(localeFolder(entry), entry.data.featImage)
  : undefined;
const image =
  featSrc && entry.data.featImageAlt ? { src: featSrc, alt: entry.data.featImageAlt } : undefined;

const authorEntry = entry.data.author ? await getRelated(locale, entry.data.author) : undefined;
const sourceEntry = entry.data.source ? await getRelated(locale, entry.data.source) : undefined;
const roleEntry = entry.data.role ? await getRelated(locale, entry.data.role) : undefined;
const authorName = authorEntry?.data.name as string | undefined;
const sourceName = sourceEntry?.data.name as string | undefined;
const sourceUrl = sourceEntry?.data.url as string | undefined;
const roleName = roleEntry?.data.name as string | undefined;
const byline = [authorName, roleName].filter(Boolean).join(' · ');
const source =
  sourceName && sourceUrl
    ? {
        href: sourceUrl,
        label: sourceName,
        external:
          new URL(sourceUrl, siteConfig.siteUrl).origin !== new URL(siteConfig.siteUrl).origin,
      }
    : undefined;
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      type="article"
      publishedTime={publishedTime}
      {...ogImage}
      imageAlt={entry.data.og?.alt ?? title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema
      siteConfig={siteConfig}
      lang={locale}
      type="article"
      title={title}
      description={description}
      datePublished={publishedTime}
      author={authorName}
    />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    {byline ? <p>{byline}</p> : null}
    <Article
      title={title}
      datetime={publishedTime}
      dateLabel={dateFmt.format(entry.data.pubDate)}
      image={image}
      terms={terms}
      source={source}
    >
      {Content ? <Content /> : null}
    </Article>
    <RelatedPosts heading={t('blog.related')} items={related} />
  </main>
</SiteLayout>
