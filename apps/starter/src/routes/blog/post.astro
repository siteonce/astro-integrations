---
// Post page. Receives locale, the compiled path, and the blog-collection
// entry. Owns render(), related-post query, and Article + RelatedPosts
// composition. Wraps SiteLayout. No section UI beyond Measure / Flow on <main>.
import { getCollection, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import {
  getAlternatePaths,
  getAlternatePathsForPath,
  getRelated,
  localeSwitcherLinks,
  type Relation,
} from '@repo/astro-intl';
import { Hreflang } from '@repo/astro-intl/components';
import { ogImageFor } from '@repo/astro-og-image/utils/og-image-for';
import { Article, RelatedPosts, Schema, Seo } from '@repo/astro-site/components';
import { isLocal, isPreview } from '@repo/astro-site/utils/deploy-env';
import { getRelatedContent } from '@repo/astro-site/utils/related-content';
import { deployConfig } from '../../deploy.config.ts';
import intlConfig from '../../intl.config.ts';
import SiteLayout from '../../layouts/site-layout.astro';
import { ogConfig } from '../../og.config.ts';
import { siteConfig } from '../../site.config.ts';
import { useTranslations } from '../../utils/t.ts';
import { resolveFeatImage } from '../../utils/feat-image.ts';
import { localeFolder } from '../../utils/locale-folder.ts';

interface Props {
  locale: string;
  path: string;
  entry: {
    id: string;
    filePath?: string;
    body?: string;
    data: {
      id: string;
      seoTitle: string;
      seoDesc: string;
      pubDate: Date;
      tags: string[];
      author?: Relation;
      source?: Relation;
      role?: Relation;
      featImage?: string;
      featImageAlt?: string;
      og?: { alt?: string };
    };
  };
}

const { locale, path, entry } = Astro.props;
const t = useTranslations(locale);
const alternates = await getAlternatePathsForPath(locale, path);
const switcher = localeSwitcherLinks(intlConfig.locales, locale, alternates, (code, tail) =>
  tail ? getRelativeLocaleUrl(code, tail) : getRelativeLocaleUrl(code),
);

const title = entry.data.seoTitle;
const description = entry.data.seoDesc;
const publishedTime = entry.data.pubDate.toISOString();
const ogImage = ogImageFor(Astro.url.pathname, ogConfig);

const hasBody = typeof entry.body === 'string' && entry.body.length > 0;
const Content = hasBody ? (await render(entry as never)).Content : undefined;

const showDrafts = isLocal(deployConfig) || isPreview(deployConfig);
const posts = (await getCollection('blog'))
  .filter((post) => post.data.locale === locale && (post.data.status === 'published' || showDrafts))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

async function compiledPath(collection: string, id: string): Promise<string> {
  const compiled = (await getAlternatePaths(`${collection}/${id}`))[locale];
  if (!compiled) {
    throw new Error(`starter: no compiled path for "${collection}/${id}" in "${locale}".`);
  }
  return compiled;
}

const tagSlug = new Map<string, string>();
for (const tag of (await getCollection('tags')).filter((tag) => tag.data.locale === locale)) {
  tagSlug.set(localeFolder(tag), await compiledPath('tags', tag.data.id));
}
const postPath = new Map<string, string>();
for (const post of posts) {
  postPath.set(post.data.id, await compiledPath('blog', post.data.id));
}

function documentHref(paths: Map<string, string>, collection: string, id: string): string {
  const compiled = paths.get(id);
  if (!compiled) {
    throw new Error(`starter: no compiled path for "${collection}/${id}" in "${locale}".`);
  }
  return getRelativeLocaleUrl(locale, compiled);
}

const dateFmt = new Intl.DateTimeFormat(locale, { dateStyle: 'long' });
const terms = entry.data.tags.map((id) => {
  const key = `taxonomy.blogTags.${id}`;
  const value = t(key);
  return {
    href: documentHref(tagSlug, 'tags', id),
    label: value === key ? id : value,
  };
});
const related = getRelatedContent(entry, posts).map((post) => ({
  href: documentHref(postPath, 'blog', post.data.id),
  title: post.data.seoTitle,
}));
const featSrc = entry.data.featImage
  ? resolveFeatImage(localeFolder(entry), entry.data.featImage)
  : undefined;
const image =
  featSrc && entry.data.featImageAlt ? { src: featSrc, alt: entry.data.featImageAlt } : undefined;

const authorEntry = entry.data.author ? await getRelated(locale, entry.data.author) : undefined;
const sourceEntry = entry.data.source ? await getRelated(locale, entry.data.source) : undefined;
const roleEntry = entry.data.role ? await getRelated(locale, entry.data.role) : undefined;
const authorName = authorEntry?.data.name as string | undefined;
const sourceName = sourceEntry?.data.name as string | undefined;
const sourceUrl = sourceEntry?.data.url as string | undefined;
const roleName = roleEntry?.data.name as string | undefined;
const byline = [authorName, roleName].filter(Boolean).join(' · ');
const source =
  sourceName && sourceUrl
    ? {
        href: sourceUrl,
        label: sourceName,
        external:
          new URL(sourceUrl, siteConfig.siteUrl).origin !== new URL(siteConfig.siteUrl).origin,
      }
    : undefined;
---

<SiteLayout locale={locale} switcher={switcher}>
  <Fragment slot="head">
    <Seo
      siteConfig={siteConfig}
      lang={locale}
      title={title}
      description={description}
      type="article"
      publishedTime={publishedTime}
      {...ogImage}
      imageAlt={entry.data.og?.alt ?? title}
    />
    <Hreflang locale={locale} path={path} />
    <Schema
      siteConfig={siteConfig}
      lang={locale}
      type="article"
      title={title}
      description={description}
      datePublished={publishedTime}
      author={authorName}
    />
  </Fragment>

  <main class="measure measure-size-wide mx-auto flow flow-4">
    {byline ? <p>{byline}</p> : null}
    <Article
      title={title}
      datetime={publishedTime}
      dateLabel={dateFmt.format(entry.data.pubDate)}
      image={image}
      terms={terms}
      source={source}
    >
      {Content ? <Content /> : null}
    </Article>
    <RelatedPosts heading={t('blog.related')} items={related} />
  </main>
</SiteLayout>
